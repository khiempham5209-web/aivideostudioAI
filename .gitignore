# Big SFX library (downloaded by `npm run sfx:download` — too large to commit).
# Anchored to the repo root: do NOT widen this back to a bare "SFX/", or it
# will also swallow the small, curated, license-safe public/assets/sfx/
# pack that ships with the app (self-generated via ffmpeg, see
# public/assets/LICENSES.md) — that one is meant to be committed.
/SFX/

# Stock media downloaded on demand during render (Pexels) — runtime cache, not source.
assets/pexels-cache/

# Cloned-voice reference recordings (the owner's real voice) — kept local,
# still picked up by the desktop build since it copies assets/ from disk.
assets/voices/*.wav

# Desktop installer build artifacts — portable Node runtime, staged
# node_modules copy, and the compiled .exe. Rebuilt locally, not versioned.
/desktop/node/
/desktop/staging/
/desktop/dist-installer/
/desktop/dist-installer-new/
/desktop/electron-dist/
/desktop/electron-dist-new/
logs/
